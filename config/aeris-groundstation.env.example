# AERIS Raspberry Pi 4B ground-station deployment configuration (PROTECTED)
# Copy to a protected location on the Raspberry Pi (recommended: /etc/aeris/aeris.env)
# and restrict permissions, e.g.:
#   sudo mkdir -p /etc/aeris
#   sudo cp config/aeris-groundstation.env.example /etc/aeris/aeris.env
#   sudo chown root:root /etc/aeris/aeris.env
#   sudo chmod 600 /etc/aeris/aeris.env
#
# Do NOT commit real secrets. Never expose the Wi-Fi password via frontend/public API.

# Server / dashboard
AERIS_HOST=0.0.0.0
AERIS_PORT=5000
AERIS_DASHBOARD_URL=http://192.168.4.1:5000

# Wi-Fi hotspot (Raspberry Pi hosts AP; laptop connects directly, no internet required)
AERIS_HOTSPOT_SSID=aeris-groundstation
AERIS_HOTSPOT_IP=192.168.4.1
AERIS_HOTSPOT_PASSWORD=pi12345678

# Hardware/config (verify on target device)
# AERIS_MLX90640_ENABLED=1
# AERIS_LORA_ENABLED=1
# AERIS_DEVICE_ID=aeris-rpi4b-01
